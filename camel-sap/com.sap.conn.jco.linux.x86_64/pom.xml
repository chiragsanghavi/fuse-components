<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.chiragsanghavi.camel</groupId>
    <artifactId>camel-sap-parent</artifactId>
    <version>4.10.2</version>
    <relativePath>..</relativePath>
  </parent>

  <groupId>io.github.chiragsanghavi.camel</groupId>
  <artifactId>sapjco3-linux-x86_64</artifactId>
  <version>3.1.13</version>
  <packaging>bundle</packaging>

  <name>SAP JCo Native Wrapper :: Linux x86_64</name>
  <description>SAP JCo native wrapper for 64-bit Linux on x86_64</description>

  <properties>
    <sapjco.version>3.1.13</sapjco.version>
    <sapjco.native.classifier>linux-x86_64</sapjco.native.classifier>
    <native.directory>${project.build.directory}/native</native.directory>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.chiragsanghavi.camel</groupId>
      <artifactId>sapjco3-osgi</artifactId>
      <version>${sapjco.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.sap.conn.jco</groupId>
      <artifactId>sapjco3</artifactId>
      <version>${sapjco.version}</version>
      <classifier>${sapjco.native.classifier}</classifier>
      <type>so</type>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-linux-native-library</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>com.sap.conn.jco</groupId>
                  <artifactId>sapjco3</artifactId>
                  <version>${sapjco.version}</version>
                  <classifier>${sapjco.native.classifier}</classifier>
                  <type>so</type>
                  <outputDirectory>${native.directory}</outputDirectory>
                  <destFileName>libsapjco3.so</destFileName>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.felix</groupId>
        <artifactId>maven-bundle-plugin</artifactId>
        <extensions>true</extensions>
        <configuration>
          <instructions>
            <Bundle-Name>SAP JCo native wrapper for Linux x86_64</Bundle-Name>
            <Bundle-SymbolicName>com.sap.conn.jco.linux.x86_64</Bundle-SymbolicName>
            <Bundle-Version>${project.version}</Bundle-Version>
            <Bundle-Vendor>SAP SE</Bundle-Vendor>
            <Fragment-Host>com.sap.conn.jco;bundle-version="${sapjco.version}"</Fragment-Host>
            <Bundle-NativeCode>libsapjco3.so;osname=Linux;processor=x86-64</Bundle-NativeCode>
            <Include-Resource>libsapjco3.so=${native.directory}/libsapjco3.so</Include-Resource>
          </instructions>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
